# Discord Bot Token (de https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=tu_token_de_discord_aqui

# Steam Web API Key (de https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=tu_steam_api_key_aqui

# (Opcional) ID de tu servidor de Discord para registrar slash commands al instante durante pruebas
# GUILD_ID=123456789012345678

# (Opcional) URL de datos de L4D2Center si consigues su endpoint real (usa {steam64} como comodín).
# Ejemplo: L4D2CENTER_API_URL=https://l4d2center.com/players/?steamid={steam64}
# L4D2CENTER_API_URL=
